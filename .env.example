# Salin file ini jadi ".env" (tanpa kata .example), isi valuenya, lalu `npm run seed`.
# PENTING: .env udah dikeblok .gitignore — JANGAN pernah commit password database.

# MongoDB Atlas (gratis, tier M0): bikin cluster → Connect → Drivers →
# salin connection string, ganti <password> sama password user database.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxxxx.mongodb.net/?retryWrites=true&w=majority"
