# Contoh konfigurasi pendaftaran Nordelia 2026.
# Salin file ini jadi ".env" di akar repo, lalu isi nilainya.
# File .env TIDAK ikut ter-commit (sudah ada di .gitignore).

# URL webhook Google Apps Script panitia (wajib https).
# Ini yang meneruskan pendaftaran ke spreadsheet rekap.
GOOGLE_SHEET_WEBHOOK_URL=""
